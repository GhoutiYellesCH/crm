FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    clang \
    lld \
    llvm \
    nsis \
    tar \
    git \
    make \
    && rm -rf /var/lib/apt/lists/*

# Install pre-compiled cargo-xwin binary
RUN curl -sL https://github.com/rust-cross/cargo-xwin/releases/download/v0.23.1/cargo-xwin-v0.23.1.x86_64-unknown-linux-musl.tar.gz | tar -xz -C /usr/local/bin

# Install minimal rustup with x86_64-pc-windows-msvc target
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable --target x86_64-pc-windows-msvc
ENV PATH="/root/.cargo/bin:$PATH"

WORKDIR /app
