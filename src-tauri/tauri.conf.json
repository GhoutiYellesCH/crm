{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AegisFlow",
  "version": "0.2.0",
  "identifier": "com.aegisflow.crm",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "AegisFlow CRM — Privacy & Security Suite",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "Privacy-First CRM, Financial & Security Operations Suite",
    "longDescription": "AegisFlow CRM is a local-first desktop application combining client management, task Kanban, multi-currency invoicing, MRR recurring retainers, Zakat wealth calculation, lead generation OSINT, calendar workflows, and 3-level security audit reporting.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libsoup-3.0-0"]
      }
    }
  },
  "plugins": {
    "sql": {
      "preloadBindings": false
    }
  }
}
